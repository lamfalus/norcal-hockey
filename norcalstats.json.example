{
  "_comment": "Copy to norcalstats.json and edit. Every field is optional; these are the defaults worth knowing about.",

  "data_dir": "data",
  "export_dir": ".",

  "delay": 1.5,
  "max_requests": 20000,

  "recheck_days": 10,

  "keep_raw": true,

  "publish": false,
  "git_remote": "origin",
  "git_branch": "main",

  "_telegram": "Set both to announce completed 12U Norcal games to a channel. Secret -- keep it only here (this file's real copy is gitignored), never in the repo.",
  "telegram_bot_token": "",
  "telegram_chat_id": "",

  "log_level": "INFO",
  "log_file": "data/norcalstats.log"
}

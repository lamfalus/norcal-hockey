# The collector is written on Windows and runs on a Raspberry Pi, so the files
# that Linux executes must keep LF endings. A CRLF shebang fails with
# "bad interpreter: /usr/bin/env bash^M", and systemd rejects CRLF unit files.
*.sh        text eol=lf
norcalstats-cli text eol=lf
*.service   text eol=lf
*.timer     text eol=lf

# Saved pages used as test fixtures: keep them byte-for-byte as fetched, so the
# parser is always tested against exactly what the site served.
tests/fixtures/*.html -text
# PDF scorecards are binary; never touch their bytes (line-ending conversion
# would corrupt the Flate streams the reader decompresses).
tests/fixtures/*.pdf binary

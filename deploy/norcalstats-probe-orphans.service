[Unit]
Description=NorCal hockey: ingest scoresheet-only games with no schedule row (CAHA girls)
Documentation=https://github.com/lamfalus/norcal-hockey
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=/home/%i/norcal-hockey
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m norcalstats.cli --config /home/%i/norcal-hockey/norcalstats.json probe-orphans

# A bounded id sweep (default cap 300). Must finish before the 03:30 update so
# that run's derive/export/publish carries the newly ingested games.
TimeoutStartSec=30m

Nice=10
IOSchedulingClass=idle

# Hardening mirrors the collector: read the repo, write the data dir, talk to
# one website.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/norcal-hockey
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
